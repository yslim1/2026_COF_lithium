    atom_style full
    units           real
    pair_style      lj/cut/coul/long 12.500
    bond_style      harmonic
    angle_style     hybrid cosine/squared harmonic
    dihedral_style charmm
    improper_style umbrella
    kspace_style    ewald 0.00001
